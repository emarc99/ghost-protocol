{
  "workflow": {
    "name": "aquaghost-sentinel",
    "version": "1.0.0",
    "environment": "staging",
    "targetNetwork": "ethereum-sepolia",
    "tee": {
      "provider": "nitro",
      "regions": ["us-west-2"],
      "memoryMb": 512,
      "cpuCount": 1
    },
    "trigger": {
      "type": "cron",
      "schedule": "*/15 * * * * *"
    },
    "dataFeeds": {
      "graphSubgraph": "https://api.thegraph.com/subgraphs/name/messari/uniswap-v3-ethereum",
      "poolTarget": "0x88e6a0c2ddd26feeb64f039a2c41296fcb3f5640"
    },
    "contracts": {
      "aquaGhostApp": "0x0000000000000000000000000000000000000000",
      "aquaGhostHook": "0x0000000000000000000000000000000000000000"
    },
    "consensus": {
      "strategy": "threshold",
      "threshold": 3,
      "minSigners": 4
    }
  }
}
