pragma solidity 0.8.26;

import { IERC165 } from "@openzeppelin/contracts/utils/introspection/IERC165.sol";

/**
 * @title IReceiver
 * @notice Standard interface for Chainlink Keystone Forwarder receiver contracts.
 *         Receives verified reports generated by Chainlink CRE Workflows.
 */
interface IReceiver is IERC165 {
    /**
     * @notice Callback invoked by the KeystoneForwarder upon delivering an on-chain report.
     * @param metadata Metadata containing workflow ID, execution ID, and DON context.
     * @param report ABI-encoded consensus payload generated by runtime.report().
     */
    function onReport(bytes calldata metadata, bytes calldata report) external;
}
